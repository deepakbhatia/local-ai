{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LocalMind",
  "version": "0.1.0-beta",
  "identifier": "com.buildstation.localmind",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LocalMind",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null,
      "capabilities": [
        "main-capability"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/ollama"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IHRhdXJpIHVwZGF0ZXIgcHVibGljIGtleQpSREpSclYvS0UwS1BaZzhRelFwU2p6UnBaU2pSclZSTEpSVkpSVkpSClpSVkpSVkpSVkpSVkpSVkpSVkpSVkpSVkpSVkpSVkpSVkpSVg==",
      "endpoints": [
        "https://github.com/buildstation/localmind-releases/releases/latest/download/latest.json"
      ]
    }
  }
}