{
    "identifier": "main-capability",
    "description": "Main window capability for LocalMind",
    "windows": [
        "main"
    ],
    "permissions": [
        "core:default",
        "shell:default",
        "shell:allow-execute",
        "shell:allow-open",
        "fs:default",
        "fs:read-all",
        "fs:write-all",
        "dialog:default",
        "dialog:allow-open",
        "dialog:allow-save",
        "opener:default",
        "sql:default"
    ]
}